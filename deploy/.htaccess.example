# Example for one.com Apache hosting; check support and test before activation.
ErrorDocument 404 /404.html
RewriteEngine On
RewriteCond %{HTTP_HOST} ^www\.trattoriasantarita\.dk$ [NC]
RewriteRule ^ https://trattoriasantarita.dk%{REQUEST_URI} [R=301,L,NE]
RewriteRule ^index\.php/menu/?$ /menu.html [R=301,L,NC]
RewriteRule ^index\.php/gallery/?$ /#about [R=301,L,NC,NE]
RewriteRule ^index\.php/kontakt-os/?$ /#contact [R=301,L,NC,NE]
